<?php

$magazinePassword = (string) getenv('MAGAZINE_DB_PASSWORD');

define('DB_NAME', (string) getenv('MAGAZINE_DB_DATABASE'));
define('DB_USER', (string) getenv('MAGAZINE_DB_USERNAME'));
define('DB_PASSWORD', $magazinePassword);
define('DB_HOST', (string) getenv('MAGAZINE_DB_HOST').':'.(string) getenv('MAGAZINE_DB_PORT'));
define('DB_CHARSET', 'utf8mb4');
define('DB_COLLATE', '');
define('AUTH_KEY', hash('sha256', $magazinePassword.'AUTH_KEY'));
define('SECURE_AUTH_KEY', hash('sha256', $magazinePassword.'SECURE_AUTH_KEY'));
define('LOGGED_IN_KEY', hash('sha256', $magazinePassword.'LOGGED_IN_KEY'));
define('NONCE_KEY', hash('sha256', $magazinePassword.'NONCE_KEY'));
define('AUTH_SALT', hash('sha256', $magazinePassword.'AUTH_SALT'));
define('SECURE_AUTH_SALT', hash('sha256', $magazinePassword.'SECURE_AUTH_SALT'));
define('LOGGED_IN_SALT', hash('sha256', $magazinePassword.'LOGGED_IN_SALT'));
define('NONCE_SALT', hash('sha256', $magazinePassword.'NONCE_SALT'));

$table_prefix = 'abi_';

define('WP_DEBUG', false);
define('WP_CACHE', false);
define('DISABLE_WP_CRON', true);

if (getenv('MAGAZINE_BLOCK_EXTERNAL') === '1') {
    define('WP_HTTP_BLOCK_EXTERNAL', true);
}

$magazineUrl = rtrim((string) getenv('MAGAZINE_URL'), '/');
if ($magazineUrl !== '') {
    define('WP_HOME', $magazineUrl);
    define('WP_SITEURL', $magazineUrl);
}

if (! defined('ABSPATH')) {
    define('ABSPATH', __DIR__.'/../public/magazine/');
}

require_once ABSPATH.'wp-settings.php';
