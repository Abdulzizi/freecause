--- /etc/nginx/sites-enabled/freecause-com.before
+++ /etc/nginx/sites-enabled/freecause-com
@@ -1,7 +1,8 @@
 # Production vhost — canonical host www.freecause.com — serves the release app
 # Apex freecause.com permanently redirects to www (path + query preserved).
 server {
-    server_name www.freecause.com;
+    include /etc/nginx/snippets/freecause-origin-guard.conf;
+    server_name www.freecause.com ads.freecause.com;
 
     root /var/www/freecause/current/public;
     index index.php;
@@ -73,6 +74,7 @@
 
 # Apex HTTPS -> permanent redirect to www (path + query preserved)
 server {
+    include /etc/nginx/snippets/freecause-origin-guard.conf;
     listen [::]:443 ssl;
     listen 443 ssl;
     server_name freecause.com;
@@ -91,6 +93,7 @@
 
 # HTTP (both hosts) -> permanent redirect to https://www.freecause.com (path + query preserved)
 server {
+    include /etc/nginx/snippets/freecause-origin-guard.conf;
     listen 80;
     listen [::]:80;
     server_name freecause.com www.freecause.com;
--- /etc/nginx/sites-available/default.before
+++ /etc/nginx/sites-available/default
@@ -1,10 +1,13 @@
+# Bare IP and unknown hostnames never serve duplicate application content.
 server {
     listen 80 default_server;
     listen [::]:80 default_server;
-    root /var/www/html;
-    index index.html index.htm index.nginx-debian.html;
+    listen 443 ssl default_server;
+    listen [::]:443 ssl default_server;
     server_name _;
-    location / {
-        try_files $uri $uri/ =404;
-    }
+    ssl_certificate /etc/letsencrypt/live/freecause.com/fullchain.pem;
+    ssl_certificate_key /etc/letsencrypt/live/freecause.com/privkey.pem;
+    include /etc/letsencrypt/options-ssl-nginx.conf;
+    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
+    return 301 https://www.freecause.com$request_uri;
 }
